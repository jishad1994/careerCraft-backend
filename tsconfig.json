{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "typeRoots": ["./src/interfaces", "./node_modules/@types"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "eslint.config.ts"]
}